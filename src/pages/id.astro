---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Yukun Drive — Solusi Motor Mikro & Pompa Mini | Shenzhen"
  description="Supplier motor DC mikro, gear motor N20, pompa diafragma mini, micro switch IP67. FOB Shenzhen. Sampel 1 minggu. Melayani pasar Indonesia."
>

<!-- Hero -->
<section class="py-20 bg-gradient-to-br from-[var(--color-bg-primary)] to-blue-950">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <p class="text-blue-400 text-sm tracking-widest mb-4">FOB SHENZHEN · SAMPEL 1 MINGGU</p>
    <h1 class="text-4xl md:text-5xl font-bold mb-6">
      Solusi <span class="text-blue-400">Motor Mikro</span> & Komponen untuk Pasar Indonesia
    </h1>
    <p class="text-lg text-[var(--color-text-secondary)] max-w-2xl mx-auto mb-8">
      Supplier langsung dari Shenzhen — motor DC gear, pompa mini, micro switch, dan aktuator.
      Harga pabrik, sampel cepat, siap kirim ke Jakarta & seluruh Indonesia.
    </p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="/contact" class="px-6 py-3 bg-blue-600 hover:bg-blue-500 rounded-lg font-semibold transition">
        Minta Penawaran →
      </a>
      <a href="#produk" class="px-6 py-3 border border-gray-600 hover:border-gray-400 rounded-lg transition">
        Lihat Produk ↓
      </a>
    </div>
  </div>
</section>

<!-- Why Yukun -->
<section class="py-16 bg-[var(--color-bg-secondary)]">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-2xl font-bold mb-10 text-center">Kenapa Yukun Drive?</h2>
    <div class="grid md:grid-cols-3 gap-8 text-center">
      <div class="p-6 rounded-lg bg-[var(--color-bg-primary)]">
        <div class="text-3xl mb-3">🏭</div>
        <h3 class="font-semibold mb-2">Langsung dari Pabrik</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Tanpa perantara. Harga FOB Shenzhen. Bisa negosiasi langsung.</p>
      </div>
      <div class="p-6 rounded-lg bg-[var(--color-bg-primary)]">
        <div class="text-3xl mb-3">📦</div>
        <h3 class="font-semibold mb-2">Sampel 1 Minggu</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Kirim sampel dalam 7 hari. Produksi massal 2-4 minggu.</p>
      </div>
      <div class="p-6 rounded-lg bg-[var(--color-bg-primary)]">
        <div class="text-3xl mb-3">🔧</div>
        <h3 class="font-semibold mb-2">Dukungan Teknis</h3>
        <p class="text-sm text-[var(--color-text-secondary)]">Datasheet, BOM, diagram teknis tersedia. Bisa custom sesuai kebutuhan.</p>
      </div>
    </div>
  </div>
</section>

<!-- Top Products for Indonesia -->
<section id="produk" class="py-16">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-2xl font-bold mb-2 text-center">Produk Terlaris untuk Indonesia</h2>
    <p class="text-center text-[var(--color-text-secondary)] mb-10">Kategori paling banyak dicari di Shopee & Tokopedia</p>

    <div class="grid md:grid-cols-2 gap-6">
      <!-- N20 Motor -->
      <a href="/products/n20-metal-spur-gear-motor" class="block p-6 rounded-lg bg-[var(--color-bg-secondary)] hover:ring-1 hover:ring-blue-500 transition">
        <h3 class="text-lg font-semibold mb-2">N20 Gear Motor — DC 12mm</h3>
        <p class="text-sm text-[var(--color-text-secondary)] mb-3">
          Motor DC mikro 12mm. Torsi 0.8-2.0 kg·cm. Ratio 30:1 hingga 1000:1.
          Untuk smart lock, IoT, robot kecil, dan peralatan otomatis.
        </p>
        <div class="flex gap-3 text-xs">
          <span class="px-2 py-1 bg-blue-900/50 text-blue-300 rounded">FOB Mulai $2.80</span>
          <span class="px-2 py-1 bg-green-900/50 text-green-300 rounded">Stok Siap</span>
          <span class="px-2 py-1 bg-green-900/50 text-green-300 rounded">Custom OK</span>
        </div>
      </a>

      <!-- Micro Pump -->
      <a href="/products/micro-diaphragm-pump" class="block p-6 rounded-lg bg-[var(--color-bg-secondary)] hover:ring-1 hover:ring-blue-500 transition">
        <h3 class="text-lg font-semibold mb-2">Pompa Diafragma Mini — 12V/24V</h3>
        <p class="text-sm text-[var(--color-text-secondary)] mb-3">
          Pompa mini 0.5-3.0 L/menit. Self-priming, <40dB.
          Untuk dispenser air, mesin kopi, alat medis, dan akuarium.
        </p>
        <div class="flex gap-3 text-xs">
          <span class="px-2 py-1 bg-blue-900/50 text-blue-300 rounded">FOB Mulai $3.80</span>
          <span class="px-2 py-1 bg-green-900/50 text-green-300 rounded">Stok Siap</span>
        </div>
      </a>

      <!-- Micro Switch -->
      <a href="/products/ip67-micro-switch" class="block p-6 rounded-lg bg-[var(--color-bg-secondary)] hover:ring-1 hover:ring-blue-500 transition">
        <h3 class="text-lg font-semibold mb-2">Micro Switch IP67 — Tahan Air</h3>
        <p class="text-sm text-[var(--color-text-secondary)] mb-3">
          Switch mikro sealed 5A 125VAC. 100.000+ siklus. IP67 waterproof.
          Untuk otomotif, smart lock, dan peralatan outdoor.
        </p>
        <div class="flex gap-3 text-xs">
          <span class="px-2 py-1 bg-blue-900/50 text-blue-300 rounded">FOB Mulai $0.45</span>
          <span class="px-2 py-1 bg-green-900/50 text-green-300 rounded">Stok Siap</span>
          <span class="px-2 py-1 bg-green-900/50 text-green-300 rounded">IATF16949</span>
        </div>
      </a>

      <!-- EV Actuator -->
      <a href="/products/ev-charging-gun-actuator" class="block p-6 rounded-lg bg-[var(--color-bg-secondary)] hover:ring-1 hover:ring-blue-500 transition">
        <h3 class="text-lg font-semibold mb-2">Aktuator Kunci EV — IP55</h3>
        <p class="text-sm text-[var(--color-text-secondary)] mb-3">
          Aktuator pengunci charging gun. 12VDC, IP55, 30.000+ siklus.
          Kompatibel GB/T, CCS, CHAdeMO. Respon <0.5 detik.
        </p>
        <div class="flex gap-3 text-xs">
          <span class="px-2 py-1 bg-blue-900/50 text-blue-300 rounded">FOB Mulai $3.50</span>
          <span class="px-2 py-1 bg-green-900/50 text-green-300 rounded">Stok Siap</span>
        </div>
      </a>
    </div>
  </div>
</section>

<!-- Shipping & Payment -->
<section class="py-16 bg-[var(--color-bg-secondary)]">
  <div class="max-w-4xl mx-auto px-4">
    <h2 class="text-2xl font-bold mb-10 text-center">Pengiriman ke Indonesia</h2>
    <div class="grid md:grid-cols-2 gap-6">
      <div class="p-6 rounded-lg bg-[var(--color-bg-primary)]">
        <h3 class="font-semibold mb-3">🚢 Opsi Pengiriman</h3>
        <ul class="text-sm text-[var(--color-text-secondary)] space-y-2">
          <li>• Ekspres (DHL/FedEx): 3-5 hari</li>
          <li>• Laut LCL ke Jakarta: 18-25 hari</li>
          <li>• Shopee SLS: 7-12 hari</li>
          <li>• Gudang Jakarta (segera hadir)</li>
        </ul>
      </div>
      <div class="p-6 rounded-lg bg-[var(--color-bg-primary)]">
        <h3 class="font-semibold mb-3">💳 Pembayaran</h3>
        <ul class="text-sm text-[var(--color-text-secondary)] space-y-2">
          <li>• Transfer Bank (USD/IDR)</li>
          <li>• Wise / Payoneer</li>
          <li>• Western Union</li>
          <li>• ShopeePay (melalui toko Shopee)</li>
        </ul>
      </div>
    </div>
  </div>
</section>

<!-- Trust -->
<section class="py-16">
  <div class="max-w-4xl mx-auto px-4 text-center">
    <h2 class="text-2xl font-bold mb-6">Siap Kirim ke Indonesia?</h2>
    <p class="text-[var(--color-text-secondary)] mb-8 max-w-xl mx-auto">
      Kami sudah melayani pelanggan dari Asia Tenggara.
      Harga FOB Shenzhen, dokumen lengkap, sampel cepat.
      Hubungi kami sekarang untuk penawaran khusus pasar Indonesia.
    </p>
    <div class="flex gap-4 justify-center flex-wrap">
      <a href="/contact" class="px-8 py-3 bg-blue-600 hover:bg-blue-500 rounded-lg font-semibold transition">
        Minta Penawaran →
      </a>
      <a href="mailto:info@yukun-drive.com" class="px-8 py-3 border border-gray-600 hover:border-gray-400 rounded-lg transition">
        Email Kami
      </a>
    </div>
    <p class="text-xs text-[var(--color-text-secondary)] mt-6">
      🇮🇩 Melayani Indonesia · Jakarta · Surabaya · Bandung · Medan
    </p>
  </div>
</section>

</BaseLayout>
