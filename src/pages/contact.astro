---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<BaseLayout title="Project Review | Yukun" description="Tell Yukun about your hardware project, development stage, and key requirements to determine the next practical review step.">
  <section class="industrial-hero">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 gap-12 py-16 md:py-20 lg:grid-cols-2">
        <!-- Left: Form -->
        <div>
          <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical)] mb-3">Project Fit Check</p>
          <h1 class="contact-intro__title">Tell us about your hardware project.</h1>
          <p class="contact-intro__summary">
            Share what you know today &mdash; product, stage, and key requirements. We will confirm whether a focused project review is the right next step.
          </p>
          <p class="contact-intro__note">CAD, a BOM, a prototype, or test evidence is useful when available, but not required to start the conversation.</p>

          <div class="contact-tabs" role="tablist" aria-label="Inquiry type">
            <button
              id="tab-rfq"
              class="contact-tab contact-tab--active"
              role="tab"
              aria-controls="form-rfq"
              aria-selected="true"
            >
              Project review
            </button>
            <button
              id="tab-sample"
              class="contact-tab"
              role="tab"
              aria-controls="form-sample"
              aria-selected="false"
            >
              Discuss Sample Needs
            </button>
          </div>

          <div id="form-rfq" role="tabpanel" aria-labelledby="tab-rfq">
            <ContactForm formType="rfq" entryContent="project-fit-check" client:load />
          </div>
          <div id="form-sample" class="hidden" role="tabpanel" aria-labelledby="tab-sample">
            <ContactForm formType="sample" entryContent="contact" client:load />
          </div>
        </div>

        <!-- Right: Contact Info -->
        <aside class="lg:pl-12" aria-label="Project review guidance">
          <div class="sticky top-24 space-y-8">
            <div class="bg-[var(--color-navy)] border border-[var(--color-navy)] p-6 text-[var(--color-navy-ink)]">
              <p class="tech-mono text-xs uppercase tracking-[0.16em] text-[var(--color-technical-light)] mb-3">Direct contact</p>
              <h2 class="text-2xl font-semibold mb-5 text-[var(--color-navy-ink)]">Start with a working discussion.</h2>
              <ul class="space-y-3 text-sm">
                <li class="flex items-center gap-3">
                  <span class="text-xl">Email</span>
                  <div>
                    <p class="text-[var(--color-navy-ink-muted)]">Email</p>
                    <a href="mailto:chinajpq@outlook.com" class="text-[var(--color-technical-light)] hover:text-white">chinajpq@outlook.com</a>
                  </div>
                </li>
                <li class="flex items-center gap-3">
                  <span class="text-xl">Location</span>
                  <div>
                    <p class="text-[var(--color-navy-ink-muted)]">Location</p>
                    <p class="text-[var(--color-navy-ink)]">Shenzhen, Guangdong, China</p>
                  </div>
                </li>
              </ul>
            </div>

            <div class="bg-white border border-[var(--color-border)] p-6 text-[var(--color-ink)]">
              <p class="tech-mono text-xs uppercase tracking-[0.16em] text-[var(--color-technical)] mb-3">Review sequence</p>
              <h2 class="text-2xl font-semibold mb-5 text-[var(--color-ink)]">What happens after you submit?</h2>
              <ol class="space-y-3 text-sm">
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 border border-[var(--color-ink)] text-[var(--color-ink)] flex items-center justify-center text-xs font-bold">1</span>
                  <p class="text-[var(--color-ink-muted)]">We review project fit, development stage, and the evidence you can share.</p>
                </li>
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 border border-[var(--color-ink)] text-[var(--color-ink)] flex items-center justify-center text-xs font-bold">2</span>
                  <p class="text-[var(--color-ink-muted)]">We identify missing information and decide whether a focused discussion would be useful.</p>
                </li>
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 border border-[var(--color-ink)] text-[var(--color-ink)] flex items-center justify-center text-xs font-bold">3</span>
                  <p class="text-[var(--color-ink-muted)]">If the project is in scope, we suggest the next practical Build, Source, or Scale step.</p>
                </li>
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 border border-[var(--color-ink)] text-[var(--color-ink)] flex items-center justify-center text-xs font-bold">4</span>
                  <p class="text-[var(--color-ink-muted)]">Specifications, availability, lead time, and commercial terms are confirmed only for a specific inquiry.</p>
                </li>
              </ol>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Simple tab switching
  const tabRFQ = document.getElementById('tab-rfq');
  const tabSample = document.getElementById('tab-sample');
  const formRFQ = document.getElementById('form-rfq');
  const formSample = document.getElementById('form-sample');

  tabRFQ?.addEventListener('click', () => {
    tabRFQ.className = 'contact-tab contact-tab--active';
    tabSample.className = 'contact-tab';
    tabRFQ.setAttribute('aria-selected', 'true');
    tabSample.setAttribute('aria-selected', 'false');
    formRFQ?.classList.remove('hidden');
    formSample?.classList.add('hidden');
  });

  tabSample?.addEventListener('click', () => {
    tabSample.className = 'contact-tab contact-tab--active';
    tabRFQ.className = 'contact-tab';
    tabSample.setAttribute('aria-selected', 'true');
    tabRFQ.setAttribute('aria-selected', 'false');
    formSample?.classList.remove('hidden');
    formRFQ?.classList.add('hidden');
  });
</script>
