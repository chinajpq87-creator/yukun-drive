---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<BaseLayout title="Free Project Fit Check | Yukun" description="Share your Pet Tech project stage, engineering evidence, target market, and production goals for a free Project Fit Check.">
  <section class="section-padding">
    <div class="max-w-7xl mx-auto">
      <div class="grid grid-cols-1 lg:grid-cols-2 gap-12">
        <!-- Left: Form -->
        <div>
          <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical)] mb-3">Project Fit Check</p>
          <h1 class="text-4xl font-bold mb-4">Start With a Free Project Fit Check</h1>
          <p class="text-lg text-[var(--color-text-secondary)] mb-8">
            Share the evidence you already have so we can review fit, missing information, and the next practical step. The free Project Fit Check confirms whether Yukun should review the project further. It does not include a full design, supplier list, formal quotation, or compliance opinion.
          </p>

          <div class="flex gap-4 mb-8">
            <button
              id="tab-rfq"
              class="px-5 py-2 text-sm font-medium bg-[var(--color-brand)] text-white rounded-lg transition-colors"
            >
              Start a Project Fit Check
            </button>
            <button
              id="tab-sample"
              class="px-5 py-2 text-sm font-medium bg-[var(--color-bg-card)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] rounded-lg border border-[var(--color-border-default)] transition-colors"
            >
              Discuss Sample Needs
            </button>
          </div>

          <div id="form-rfq">
            <ContactForm formType="rfq" entryContent="project-fit-check" client:load />
          </div>
          <div id="form-sample" class="hidden">
            <ContactForm formType="sample" entryContent="contact" client:load />
          </div>
        </div>

        <!-- Right: Contact Info -->
        <div class="lg:pl-12">
          <div class="sticky top-24 space-y-8">
            <div class="bg-[var(--color-bg-card)] border border-[var(--color-border-default)] rounded-xl p-6 text-[var(--color-navy-ink)]">
              <h3 class="text-lg font-semibold mb-4 text-[var(--color-navy-ink)]">Contact Information</h3>
              <ul class="space-y-3 text-sm">
                <li class="flex items-center gap-3">
                  <span class="text-xl">Email</span>
                  <div>
                    <p class="text-[var(--color-navy-ink-muted)]">Email</p>
                    <a href="mailto:chinajpq@outlook.com" class="text-[var(--color-technical-light)] hover:text-white">chinajpq@outlook.com</a>
                  </div>
                </li>
                <li class="flex items-center gap-3">
                  <span class="text-xl">Location</span>
                  <div>
                    <p class="text-[var(--color-navy-ink-muted)]">Location</p>
                    <p class="text-[var(--color-navy-ink)]">Shenzhen, Guangdong, China</p>
                  </div>
                </li>
              </ul>
            </div>

            <div class="bg-[var(--color-bg-card)] border border-[var(--color-border-default)] rounded-xl p-6 text-[var(--color-navy-ink)]">
              <h3 class="text-lg font-semibold mb-4 text-[var(--color-navy-ink)]">What Happens Next?</h3>
              <ol class="space-y-3 text-sm">
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[var(--color-brand)]/20 text-[var(--color-technical-light)] flex items-center justify-center text-xs font-bold">1</span>
                  <p class="text-[var(--color-navy-ink-muted)]">We review project fit, development stage, and the evidence you can share.</p>
                </li>
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[var(--color-brand)]/20 text-[var(--color-technical-light)] flex items-center justify-center text-xs font-bold">2</span>
                  <p class="text-[var(--color-navy-ink-muted)]">We identify missing information and decide whether a focused discussion would be useful.</p>
                </li>
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[var(--color-brand)]/20 text-[var(--color-technical-light)] flex items-center justify-center text-xs font-bold">3</span>
                  <p class="text-[var(--color-navy-ink-muted)]">If the project is in scope, we suggest the next practical Build, Source, or Scale step.</p>
                </li>
                <li class="flex gap-3">
                  <span class="flex-shrink-0 w-6 h-6 rounded-full bg-[var(--color-brand)]/20 text-[var(--color-technical-light)] flex items-center justify-center text-xs font-bold">4</span>
                  <p class="text-[var(--color-navy-ink-muted)]">Specifications, availability, lead time, and commercial terms are confirmed only for a specific inquiry.</p>
                </li>
              </ol>
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>

<script>
  // Simple tab switching
  const tabRFQ = document.getElementById('tab-rfq');
  const tabSample = document.getElementById('tab-sample');
  const formRFQ = document.getElementById('form-rfq');
  const formSample = document.getElementById('form-sample');

  tabRFQ?.addEventListener('click', () => {
    tabRFQ.className = 'px-5 py-2 text-sm font-medium bg-[var(--color-brand)] text-white rounded-lg transition-colors';
    tabSample.className = 'px-5 py-2 text-sm font-medium bg-[var(--color-bg-card)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] rounded-lg border border-[var(--color-border-default)] transition-colors';
    formRFQ?.classList.remove('hidden');
    formSample?.classList.add('hidden');
  });

  tabSample?.addEventListener('click', () => {
    tabSample.className = 'px-5 py-2 text-sm font-medium bg-[var(--color-brand)] text-white rounded-lg transition-colors';
    tabRFQ.className = 'px-5 py-2 text-sm font-medium bg-[var(--color-bg-card)] text-[var(--color-text-secondary)] hover:text-[var(--color-text-primary)] rounded-lg border border-[var(--color-border-default)] transition-colors';
    formSample?.classList.remove('hidden');
    formRFQ?.classList.add('hidden');
  });
</script>
