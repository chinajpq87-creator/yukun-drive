---
import BaseLayout from '../layouts/BaseLayout.astro';
import ContactForm from '../components/ContactForm.tsx';
---

<BaseLayout
  title="Motor Component Review Desk | Yukun Drive"
  description="Discuss commutator, carbon brush assembly, terminal/contact component, and waterproof switch requirements for brushed DC motor applications."
>
  <main class="bg-[var(--color-surface)]">
    <section class="bg-[var(--color-navy)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
        <div class="max-w-4xl">
          <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical-light)]">For brushed DC motor teams</p>
          <h1 class="mt-4 text-4xl md:text-5xl font-bold text-white">Motor Component Review Desk</h1>
          <p class="mt-3 text-sm font-semibold text-[var(--color-technical-light)]">Brushed DC Motor Component Matching & Supply Coordination</p>
          <p class="mt-6 text-lg leading-relaxed text-[var(--color-navy-ink-muted)]">
            Discuss commutator, carbon brush assembly, terminal/contact component, and waterproof switch requirements for motor-related applications, second-source reviews, or failure-related clarification.
          </p>
          <div class="mt-8 flex flex-col sm:flex-row gap-4">
            <a href="#inquiry" class="inline-flex items-center justify-center rounded-lg bg-[var(--color-action)] px-7 py-3.5 text-base font-semibold text-white hover:bg-[var(--color-action-hover)]">
              Discuss Your Application
            </a>
            <a href="mailto:chinajpq@outlook.com" class="inline-flex items-center justify-center rounded-lg border border-[var(--color-navy-border)] px-7 py-3.5 text-base font-semibold text-[var(--color-navy-ink)] hover:border-[var(--color-technical)]">
              Email Your Requirements
            </a>
          </div>
        </div>
      </div>
    </section>

    <section class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="grid gap-6 lg:grid-cols-3">
        {[
          { title: 'Who this page is for', body: 'Motor manufacturers, motor buyers, product engineers, and sourcing teams reviewing brushed DC motor component fit or second-source options.' },
          { title: 'Component review scope', body: 'Commutators, carbon brush assemblies, terminal/contact components, and waterproof micro switches used in motor-related mechanisms.' },
          { title: 'Common engineering signals', body: 'Wear pattern, contact instability, assembly fit, switching feedback, terminal interface, and application environment.' },
        ].map((item) => (
          <article class="rounded-2xl border border-[var(--color-border)] bg-white p-6 shadow-sm">
            <h2 class="text-xl font-semibold text-[var(--color-ink)]">{item.title}</h2>
            <p class="mt-3 text-sm leading-relaxed text-[var(--color-ink-muted)]">{item.body}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="bg-[var(--color-surface-muted)]">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
        <div class="grid gap-8 lg:grid-cols-[0.9fr_1.1fr] lg:items-start">
          <div>
            <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical)]">Inquiry checklist</p>
            <h2 class="mt-3 text-3xl font-semibold text-[var(--color-ink)]">What to share before inquiry</h2>
            <p class="mt-4 text-base leading-relaxed text-[var(--color-ink-muted)]">
              A short engineering note is enough to start. Share what you already know; missing information can be clarified during review.
            </p>
          </div>
          <div class="grid gap-4 sm:grid-cols-2">
            {[
              'Motor frame or application context',
              'Drawing, sample, or current component photo status',
              'Electrical and mechanical interface constraints',
              'Wear, switching, assembly, or sourcing issue',
              'Target operating environment',
              'Evaluation stage and decision timeline',
            ].map((item) => (
              <div class="rounded-xl border border-[var(--color-border)] bg-white p-4">
                <p class="text-sm font-semibold text-[var(--color-ink)]">{item}</p>
              </div>
            ))}
          </div>
        </div>
      </div>
    </section>

    <section id="inquiry" class="max-w-5xl mx-auto px-4 sm:px-6 lg:px-8 py-16">
      <div class="rounded-2xl border border-[var(--color-border)] bg-[var(--color-navy-surface)] p-6 md:p-8">
        <div class="mb-8">
          <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical-light)]">Start the review</p>
          <h2 class="mt-3 text-3xl font-semibold text-white">Send your component requirements</h2>
          <p class="mt-4 text-sm leading-relaxed text-[var(--color-navy-ink-muted)]">
            Product specifications, availability, lead time, and commercial terms are confirmed for each inquiry.
            You can also email <a href="mailto:chinajpq@outlook.com" class="text-[var(--color-technical-light)]">chinajpq@outlook.com</a>.
          </p>
        </div>
        <ContactForm formType="rfq" entryContent="motor-manufacturers" client:load />
      </div>
    </section>
  </main>
</BaseLayout>
