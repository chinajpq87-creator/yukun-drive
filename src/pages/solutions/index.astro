---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';

const solutions = await getCollection('solutions', ({ data }) => !data.draft);
---

<BaseLayout title="Solutions — Compact Motion Applications | Yukun" description="Explore product-matching considerations for smart locks, charging equipment, robotics, laboratory equipment, and automation.">
  <section class="industrial-hero">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-20">
      <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical)]">Application-first review</p>
      <h1 class="mt-3 max-w-3xl text-4xl md:text-5xl font-bold text-[var(--color-ink)]">Solutions by Application</h1>
      <p class="mt-4 max-w-3xl text-lg leading-relaxed text-[var(--color-ink-muted)]">Use the product context to identify the mechanism, operating conditions, integration constraints, and evidence needed before component matching.</p>
      <a href="/contact/?entry=application-review" data-analytics-event="application_review_cta_click" data-analytics-location="solutions_hero" data-analytics-label="Discuss an application" class="mt-7 inline-flex border border-[var(--color-ink)] bg-[var(--color-ink)] px-5 py-3 text-sm font-semibold text-white transition-colors hover:border-[var(--color-action)] hover:bg-[var(--color-action)]">Discuss an application</a>
    </div>
  </section>

  <section class="section-padding">
    <div class="max-w-7xl mx-auto">
      <div class="mb-12 grid gap-6 border border-[var(--color-border)] bg-[var(--color-surface-muted)] p-6 md:grid-cols-[.75fr_1.25fr] md:items-center">
        <div>
          <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical)]">Application review lens</p>
          <h2 class="mt-3 text-3xl font-bold text-[var(--color-ink)]">Define the system before selecting the part</h2>
        </div>
        <p class="text-base leading-relaxed text-[var(--color-ink-muted)]">Each route should start with the movement required, load path, environment, control and sensing, product architecture, and validation questions. The page is a discussion framework — final components and specifications are confirmed per inquiry.</p>
      </div>

      {solutions.length === 0 ? (
        <div class="text-center py-20">
          <p class="text-[var(--color-text-muted)] text-lg">Solution pages coming soon.</p>
          <a href="/contact/" class="inline-block mt-4 text-[var(--color-brand-light)] hover:text-[var(--color-brand)] font-medium">
            Contact us for your specific application →
          </a>
        </div>
      ) : (
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6">
          {solutions.map((s) => (
            <a
              href={`/solutions/${s.data.slug}/`}
              class="group block border border-[var(--color-border)] bg-white p-6 transition-colors hover:border-[var(--color-technical)]"
            >
              <div class="text-3xl mb-4">📐</div>
              <h2 class="text-lg font-semibold text-[var(--color-ink)] group-hover:text-[var(--color-technical)] transition-colors mb-2">
                {s.data.title?.split('|')[0]?.trim()}
              </h2>
              <p class="text-sm text-[var(--color-ink-muted)] line-clamp-3 mb-4">
                {s.data.meta_description}
              </p>
              {s.data.target_industries && s.data.target_industries.length > 0 && (
                <div class="flex flex-wrap gap-1.5">
                  {s.data.target_industries.map((ind: string) => (
                    <span class="text-xs border border-[var(--color-border)] px-2 py-0.5 text-[var(--color-ink-muted)]">
                      {ind}
                    </span>
                  ))}
                </div>
              )}
            </a>
          ))}
        </div>
      )}
    </div>
  </section>
</BaseLayout>
