---
// Global footer
---

<footer class="bg-[var(--color-navy-surface)] border-t border-[var(--color-navy-border)]">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-12">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-8">
      <!-- Solutions -->
      <div>
        <h4 class="text-sm font-semibold text-[var(--color-navy-ink)] mb-3">Solutions</h4>
        <ul class="space-y-2">
          <li><a href="/solutions/medical-device-micro-drive" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Medical Devices</a></li>
          <li><a href="/solutions/smart-lock-micro-motor" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Smart Lock</a></li>
          <li><a href="/solutions/ev-charging-gun-actuator" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">EV Charging</a></li>
          <li><a href="/solutions" class="text-sm text-[var(--color-technical)] hover:text-[var(--color-technical-light)]">All Solutions &rarr;</a></li>
        </ul>
      </div>

      <!-- Products -->
      <div>
        <h4 class="text-sm font-semibold text-[var(--color-navy-ink)] mb-3">Products</h4>
        <ul class="space-y-2">
          <li><a href="/products" class="text-sm text-[var(--color-technical)] hover:text-[var(--color-technical-light)]">All Products &rarr;</a></li>
        </ul>
      </div>

      <!-- Resources -->
      <div>
        <h4 class="text-sm font-semibold text-[var(--color-navy-ink)] mb-3">Resources</h4>
        <ul class="space-y-2">
          <li><a href="/resources" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Selection Guides</a></li>
          <li><a href="/resources" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Datasheets</a></li>
          <li><a href="/blog" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Technical Blog</a></li>
          <li><a href="/resources" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">FAQ</a></li>
        </ul>
      </div>

      <!-- Company -->
      <div>
        <h4 class="text-sm font-semibold text-[var(--color-navy-ink)] mb-3">Company</h4>
        <ul class="space-y-2">
          <li><a href="/about" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">About Yukun</a></li>
          <li><a href="/contact" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Contact Us</a></li>
          <li><a href="/privacy-policy" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Privacy Policy</a></li>
          <li><a href="/terms" class="text-sm text-[var(--color-navy-ink-muted)] hover:text-[var(--color-technical)]">Terms</a></li>
        </ul>
      </div>
    </div>

    <!-- Social Media Row -->
    <div class="mt-12 pt-8 border-t border-[var(--color-navy-border)] flex flex-col md:flex-row justify-between items-center gap-6">
      <div class="flex items-center gap-2 text-sm text-[var(--color-navy-ink-muted)]">
        <span class="text-[var(--color-technical)]">&#x2B21;</span>
        <span>&copy; {new Date().getFullYear()} Yukun (Shenzhen) Supply Chain Technology Co., Ltd. All rights reserved.</span>
      </div>
      <div class="flex items-center gap-6">
        <div class="flex items-center gap-4 text-sm text-[var(--color-navy-ink-muted)]">
          <span>Shenzhen, China</span>
          <a href="mailto:chinajpq@outlook.com" class="hover:text-[var(--color-technical)]">chinajpq@outlook.com</a>
        </div>
      </div>
    </div>
  </div>
</footer>
