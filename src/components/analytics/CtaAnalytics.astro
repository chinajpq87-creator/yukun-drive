<script>
  const pendingCtaEventKey = 'yukun_pending_cta_event';

  const isSameTabNavigation = (target: HTMLElement, event: MouseEvent) =>
    target instanceof HTMLAnchorElement &&
    event.button === 0 &&
    !event.defaultPrevented &&
    !event.metaKey &&
    !event.ctrlKey &&
    !event.shiftKey &&
    !event.altKey &&
    !target.hasAttribute('download') &&
    (!target.target || target.target === '_self') &&
    target.origin === window.location.origin;

  const emitPendingCtaEvent = () => {
    try {
      const serializedEvent = sessionStorage.getItem(pendingCtaEventKey);
      if (!serializedEvent) return;

      sessionStorage.removeItem(pendingCtaEventKey);
      const pendingEvent = JSON.parse(serializedEvent);
      if (typeof pendingEvent.name !== 'string' || typeof pendingEvent.payload !== 'object') return;

      window.gtag?.('event', pendingEvent.name, pendingEvent.payload);
    } catch {
      // Storage may be unavailable; normal navigation must still continue.
    }
  };

  emitPendingCtaEvent();

  document.addEventListener('click', (event) => {
    const target = (event.target as Element | null)?.closest<HTMLElement>('[data-analytics-event]');
    if (!target) return;

    const payload = {
      cta_location: target.dataset.analyticsLocation || 'unknown',
      cta_label: target.dataset.analyticsLabel || target.textContent?.trim() || 'unknown',
      entry_content: new URLSearchParams(window.location.search).get('entry') || undefined,
    };

    if (isSameTabNavigation(target, event)) {
      try {
        sessionStorage.setItem(
          pendingCtaEventKey,
          JSON.stringify({ name: target.dataset.analyticsEvent, payload })
        );
        return;
      } catch {
        // Fall through to best-effort source-page tracking when storage is unavailable.
      }
    }

    window.gtag?.('event', target.dataset.analyticsEvent!, payload);
  });
</script>
