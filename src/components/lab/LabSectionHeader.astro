---
interface Props {
  eyebrow: string;
  title: string;
  description?: string;
  align?: 'left' | 'center';
}

const { eyebrow, title, description, align = 'left' } = Astro.props;
const wrapperClass = align === 'center' ? 'text-center mx-auto' : '';
---

<div class:list={['max-w-3xl', wrapperClass]}>
  <p class="tech-mono text-xs uppercase tracking-[0.18em] text-[var(--color-technical-light)]">
    {eyebrow}
  </p>
  <h2 class="mt-3 text-3xl md:text-4xl font-semibold text-[var(--color-text-primary)]">
    {title}
  </h2>
  {description && (
    <p class="mt-4 text-base md:text-lg leading-relaxed text-[var(--color-text-secondary)]">
      {description}
    </p>
  )}
</div>
